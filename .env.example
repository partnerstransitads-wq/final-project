# ---------- Gemini ----------
GEMINI_API_KEY=your_key_from_aistudio.google.com
GEMINI_MODEL=gemini-2.5-flash
GEMINI_RPM=8                       # stay under the free-tier requests/minute limit

# ---------- Google Sheets ----------
GOOGLE_SHEET_ID=1AbC...            # the long id in the sheet URL
# Provide ONE of the following:
GOOGLE_SERVICE_ACCOUNT_FILE=./service-account.json
# GOOGLE_SERVICE_ACCOUNT_B64=<base64 of the JSON file>   # handy for hosts without file upload

# ---------- Academy ----------
ACADEMY_NAME=Bright Future Academy
OWNER_PHONES=923001234567           # comma-separated, international format, no +
OWNER_LIDS=                        # optional, comma-separated "@lid" ids (see README, "LID" note)
ALLOWED_GROUP_JIDS=                # empty = every group, teachers only
TEACHER_PHONES=923001112222         # REQUIRED: only these senders can trigger the bot

# ---------- Attendance ----------
ATTENDANCE_BUFFER_MINUTES=5
BATCH_GRACE_SECONDS=60             # list split over several messages in the first 60 s still counts as Present
ADDITIONAL_NAMES_STATUS=late       # late | present  (names added after the grace window)
PARENT_HOLD_SECONDS=120            # wait before DM-ing parents so the teacher can fix typos
PARENT_HOLD_UNMATCHED_SECONDS=600  # longer wait when some names could not be matched
SHOW_SCORES_IN_GROUP=true          # false = only class stats in the group, scores go to parents only

# ---------- Anti-ban queue ----------
PARENT_DELAY_MIN_SEC=15
PARENT_DELAY_MAX_SEC=25
MAX_PARENT_MSGS_PER_DAY=150

# ---------- Fees ----------
FEE_REMINDER_START_DAY=5
FEE_REMINDER_INTERVAL_DAYS=5
FEE_MAX_REMINDERS=4
PAYMENT_MIN_CONFIDENCE=0.6
SEND_PARENT_RECEIPT=false

# ---------- Server / storage ----------
PORT=3000
ADMIN_TOKEN=change-me              # protects /qr and /status
STATE_DIR=./state
AUTH_DIR=./auth_info_baileys
LOG_LEVEL=info
